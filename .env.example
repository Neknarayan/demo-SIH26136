# .env.example — Project Root (for docker compose production)
# Copy to .env and fill in your values before running:
#   docker compose up --build -d
#
# NEVER commit .env — it is in .gitignore

# Strong password for PostgreSQL (no special shell chars like @ $ !)
POSTGRES_PASSWORD=yourStrongPasswordHere

# JWT signing secret — minimum 32 random characters
JWT_SECRET_KEY=yourRandomSecretAtLeast32CharsLong!

# Comma-separated allowed origins for CORS
# In production, set to your actual domain(s)
CORS_ORIGINS=http://localhost,https://yourdomain.com
