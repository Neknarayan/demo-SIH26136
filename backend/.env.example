# ──────────────────────────────────────────────────────────────────────────────
# backend/.env.example
# Copy this file to backend/.env and fill in your values.
# NEVER commit the actual .env file — it is in .gitignore.
# ──────────────────────────────────────────────────────────────────────────────

# PostgreSQL connection string
# Local dev (after running docker-compose.dev.yml):
DATABASE_URL=postgresql+psycopg://postgres:mysecretpassword@localhost:5432/sih_db

# Application environment: development | test | production
APP_ENV=development

# JWT signing key — must be at least 32 random characters in production
JWT_SECRET_KEY=my-local-dev-secret-change-in-production

# Token expiry in minutes (default: 60)
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Comma-separated allowed government email domains
GOV_EMAIL_DOMAINS=gov.in,nic.in

# Set to true to allow any email to register as government officer (dev only!)
ALLOW_OPEN_GOV_REGISTRATION=false

# Comma-separated list of allowed CORS origins for the frontend
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Set to true to enable demo/seed data mode
DEMO_MODE=false
